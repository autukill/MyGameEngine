<Project>
  <!-- 启用中央包管理 (Central Package Management) -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionsDirectory>$(MSBuildThisFileDirectory)</CentralPackageVersionsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Engine 核心依赖 (Silk.NET — OpenGL/Windowing/Input/Math) -->
    <PackageVersion Include="Silk.NET.Windowing" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.Input" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.Maths" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.22.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageVersion Include="SkiaSharp" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    <PackageVersion Include="Imazen.WebP" Version="11.0.0" />
    <PackageVersion Include="Imazen.WebP.NativeRuntime.All" Version="1.6.1" />
    <PackageVersion Include="NVorbis" Version="0.10.5" />
    <PackageVersion Include="OggVorbisEncoder" Version="1.2.2" />

    <!-- 编辑器 Web 后端 (SignalR) — 预留, Phase 2.x 编辑器切片使用 -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR" Version="1.2.0" />

    <!-- 编辑器前端 (client-editor) 通过 npm 管理, 以下为参考 -->
    <PackageVersion Include="Microsoft.TypeScript.MSBuild" Version="5.6.0" />
  </ItemGroup>
</Project>
