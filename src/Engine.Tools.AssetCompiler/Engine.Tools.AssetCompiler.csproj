<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GameEngine.Tools.AssetCompiler</RootNamespace>
    <AssemblyName>GameEngineAssetCompiler</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>gameengine-assets</ToolCommandName>
    <PackageId>MyGameEngine.AssetCompiler</PackageId>
    <Version>$(GameEnginePackageVersion)</Version>
    <Authors>MyGameEngine</Authors>
    <Description>Offline compiler and strongly typed reference generator for MyGameEngine content and Shader assets.</Description>
    <PackageTags>game-engine;content-pipeline;texture-atlas;webp;sprite;shader;material</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Imazen.WebP" />
    <PackageReference Include="Imazen.WebP.NativeRuntime.All" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\docs\CONTENT_PIPELINE_PACKAGES.md"
          Pack="true"
          PackagePath="README.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Engine.Core\Engine.Core.csproj" />
    <ProjectReference Include="..\Engine.Features\ContentAssets\ContentAssets.csproj" />
    <ProjectReference Include="..\Engine.Features\ShaderAssets\ShaderAssets.csproj" />
    <ProjectReference Include="..\Engine.Features\TextureAssets\TextureAssets.csproj" />
    <ProjectReference Include="..\Engine.Features\TextureAtlas\TextureAtlas.csproj" />
  </ItemGroup>

  <Target Name="RemovePublishedToolSymbols" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedToolSymbol Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedToolSymbol)" />
  </Target>
</Project>
