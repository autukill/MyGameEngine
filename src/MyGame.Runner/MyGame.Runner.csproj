<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MyGame.Runner</RootNamespace>
    <AssemblyName>MyGameRunner</AssemblyName>
    <GameEngineContentPackagesRoot>$(MSBuildProjectDirectory)\Assets</GameEngineContentPackagesRoot>
    <GameEngineContentManifest>assets.json</GameEngineContentManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 版本由 Directory.Packages.props 统一管理 -->
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.Maths" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine.Core\Engine.Core.csproj" />
    <ProjectReference Include="..\Engine.Features\Camera\Camera.csproj" />
    <ProjectReference Include="..\Engine.Features\ContentAssets\ContentAssets.csproj" />
    <ProjectReference Include="..\Engine.Features\RenderPipeline\RenderPipeline.csproj" />
    <ProjectReference Include="..\Engine.Features\Sprites\Sprites.csproj" />
    <ProjectReference Include="..\Engine.Features\StencilMasking\StencilMasking.csproj" />
    <ProjectReference Include="..\Engine.Features\TextureAssets\TextureAssets.csproj" />
    <ProjectReference Include="..\Engine.Tools.AssetCompiler\Engine.Tools.AssetCompiler.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="..\..\build\GameEngine.Content.targets" />
</Project>
