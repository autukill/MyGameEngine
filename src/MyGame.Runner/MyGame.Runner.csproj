<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MyGame.Runner</RootNamespace>
    <AssemblyName>MyGameRunner</AssemblyName>
    <GameEngineContentPackagesRoot>$(MSBuildProjectDirectory)\Assets</GameEngineContentPackagesRoot>
    <GameEngineContentManifest>assets.json</GameEngineContentManifest>
    <GameEngineShaderManifest>$(MSBuildProjectDirectory)\Shaders\shaders.json</GameEngineShaderManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 版本由 Directory.Packages.props 统一管理 -->
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.Maths" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Shaders\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine.Core\Engine.Core.csproj" />
    <ProjectReference Include="..\Engine.Hosting\Engine.Hosting.csproj" />
    <ProjectReference Include="..\Engine.Features\Bloom\Bloom.csproj" />
    <ProjectReference Include="..\Engine.Features\StencilMasking\StencilMasking.csproj" />
    <ProjectReference Include="..\Engine.Features\ToneMapping\ToneMapping.csproj" />
    <ProjectReference Include="..\Engine.Tools.AssetCompiler\Engine.Tools.AssetCompiler.csproj"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;PublishSingleFile;SelfContained;RuntimeIdentifier;RuntimeIdentifiers" />
  </ItemGroup>
  <Import Project="..\..\build\GameEngine.Content.targets" />
</Project>
