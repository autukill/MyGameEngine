<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>MyGameEngine.GameSdk</PackageId>
    <Version>$(GameEnginePackageVersion)</Version>
    <Authors>MyGameEngine</Authors>
    <Description>Complete runtime SDK for building 2D games with MyGameEngine.</Description>
    <PackageTags>game-engine;2d;opengl;sprite;runtime</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectGameSdkAssemblies</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Windowing" />
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.Maths" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Engine.Core\Engine.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Engine.Features\Bloom\Bloom.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Engine.Features\Camera\Camera.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Engine.Features\ContentAssets\ContentAssets.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Engine.Features\Presentation\Presentation.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Engine.Features\RenderPipeline\RenderPipeline.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Engine.Features\SceneSystem\SceneSystem.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Engine.Features\Sprites\Sprites.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Engine.Features\StencilMasking\StencilMasking.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Engine.Features\TextureAssets\TextureAssets.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Engine.Features\TextureAtlas\TextureAtlas.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Engine.Features\ToneMapping\ToneMapping.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Engine.Hosting\Engine.Hosting.csproj" PrivateAssets="all" />
    <None Include="..\..\docs\GAME_SDK_AND_TEMPLATES.md"
          Pack="true"
          PackagePath="README.md" />
  </ItemGroup>

  <Target Name="CollectGameSdkAssemblies">
    <ItemGroup>
      <TfmSpecificPackageFile Include="..\Engine.Core\bin\$(Configuration)\net10.0\Engine.Core.dll" />
      <TfmSpecificPackageFile Include="..\Engine.Features\Bloom\bin\$(Configuration)\net10.0\Bloom.dll" />
      <TfmSpecificPackageFile Include="..\Engine.Features\Camera\bin\$(Configuration)\net10.0\Camera.dll" />
      <TfmSpecificPackageFile Include="..\Engine.Features\ContentAssets\bin\$(Configuration)\net10.0\ContentAssets.dll" />
      <TfmSpecificPackageFile Include="..\Engine.Features\Presentation\bin\$(Configuration)\net10.0\Presentation.dll" />
      <TfmSpecificPackageFile Include="..\Engine.Features\RenderPipeline\bin\$(Configuration)\net10.0\RenderPipeline.dll" />
      <TfmSpecificPackageFile Include="..\Engine.Features\SceneSystem\bin\$(Configuration)\net10.0\SceneSystem.dll" />
      <TfmSpecificPackageFile Include="..\Engine.Features\Sprites\bin\$(Configuration)\net10.0\Sprites.dll" />
      <TfmSpecificPackageFile Include="..\Engine.Features\StencilMasking\bin\$(Configuration)\net10.0\StencilMasking.dll" />
      <TfmSpecificPackageFile Include="..\Engine.Features\TextureAssets\bin\$(Configuration)\net10.0\TextureAssets.dll" />
      <TfmSpecificPackageFile Include="..\Engine.Features\TextureAtlas\bin\$(Configuration)\net10.0\TextureAtlas.dll" />
      <TfmSpecificPackageFile Include="..\Engine.Features\ToneMapping\bin\$(Configuration)\net10.0\ToneMapping.dll" />
      <TfmSpecificPackageFile Include="..\Engine.Hosting\bin\$(Configuration)\net10.0\Engine.Hosting.dll" />
      <TfmSpecificPackageFile Update="@(TfmSpecificPackageFile)">
        <PackagePath>lib\net10.0\%(Filename)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
